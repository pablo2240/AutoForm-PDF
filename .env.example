# =============================================================================
# AUTOFORM PDF - CONFIGURACIÓN DE MODELOS DE LENGUAJE (LLM)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. AZURE OPENAI / AZURE AI FOUNDRY (PROVEEDOR EMPRESARIAL RECOMENDADO)
# -----------------------------------------------------------------------------
# Endpoint de tu recurso de Azure OpenAI o Azure Foundry (ej: https://mi-recurso.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=https://tu-recurso.openai.azure.com/

# Clave secreta de Azure OpenAI (Key 1 o Key 2 en Azure Portal / Foundry)
AZURE_OPENAI_API_KEY=tu_azure_api_key_aqui

# Nombre del Despliegue (Deployment Name) creado en Azure AI Foundry (ej: gpt-4o, gpt-4o-mini, etc.)
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Versión del API de Azure OpenAI
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Opcional: Forzar proveedor ('azure', 'openai' o 'openrouter')
# LLM_PROVIDER=azure

# -----------------------------------------------------------------------------
# 2. OPENROUTER (RESPALDO ALTERNATIVO)
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-5.6-luna

# -----------------------------------------------------------------------------
# 3. OPENAI ESTÁNDAR (DIRECTO)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
