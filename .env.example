# =============================================================================
# AUTOFORM PDF - CONFIGURACIÓN DE ENTORNO Y MODELOS DE LENGUAJE (LLM)
# =============================================================================

# -----------------------------------------------------------------------------
# 0. ENTORNO DE EJECUCIÓN (local | staging | production)
# -----------------------------------------------------------------------------
APP_ENVIRONMENT=local
SITE_URL=https://autoform.iaclatam.com
CORS_ORIGINS=https://autoform.iaclatam.com

# -----------------------------------------------------------------------------
# 1. SUPABASE MULTITENANT & SECURITY
# -----------------------------------------------------------------------------
# Project Refs separados:
# - Producción: tnhedxwbpqihlqbtzudt (PROTEGIDO - no ejecutar pruebas destructivas)
# - Staging: <staging-ref-id>
SUPABASE_PRODUCTION_REF=tnhedxwbpqihlqbtzudt
SUPABASE_STAGING_REF=nfsijcwkmcvtwsponqsw

# Staging Environment (Destructive E2E tests MUST run exclusively against staging)
SUPABASE_STAGING_URL=https://nfsijcwkmcvtwsponqsw.supabase.co
SUPABASE_STAGING_ANON_KEY=tu_staging_anon_key_aqui
SUPABASE_STAGING_SERVICE_ROLE_KEY=tu_staging_service_role_key_aqui

# -----------------------------------------------------------------------------
# 2. AZURE OPENAI / AZURE AI FOUNDRY (PROVEEDOR EMPRESARIAL RECOMENDADO)
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://tu-recurso.openai.azure.com/
AZURE_OPENAI_API_KEY=tu_azure_api_key_aqui
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# -----------------------------------------------------------------------------
# 3. OPENROUTER (RESPALDO ALTERNATIVO)
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-5.6-luna

# -----------------------------------------------------------------------------
# 4. OPENAI ESTÁNDAR (DIRECTO)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# 5. NOTIFICACIONES Y RECUPERACIÓN DE CONTRASEÑA
# -----------------------------------------------------------------------------
# Proveedor activo: 'microsoft_graph' (recomendado en producción) o 'smtp'
EMAIL_PROVIDER=microsoft_graph

# Configuración Microsoft Graph API (Microsoft Entra ID - OAuth2 Client Credentials):
# Requiere permisos de aplicación 'Mail.Send' con Admin Consent en el tenant de Entra ID.
# El remitente debe coincidir con el buzón corporativo autorizado:
MS_TENANT_ID=tu_directory_tenant_id_aqui
MS_CLIENT_ID=tu_application_client_id_aqui
MS_CLIENT_SECRET=tu_client_secret_valor_aqui
MAIL_SENDER=pablo.reyes@iaclatam.com
MAIL_SENDER_NAME=AutoForm PDF - Seguridad

# Configuración SMTP alternativa / local (Gmail App Password a costo $0):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=autoform.soporte@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres
SMTP_FROM_EMAIL=autoform.soporte@gmail.com
SMTP_FROM_NAME=AutoForm PDF - Seguridad

# -----------------------------------------------------------------------------
# 6. BIBLIOTECA DE REFERENCIAS / EMBEDDINGS / FEW-SHOT DINÁMICO (ADR-0013)
# -----------------------------------------------------------------------------
# REFERENCE_LIBRARY_ENABLED=1            # 0 desactiva toda la capa (comportamiento previo)
# REFERENCE_LIBRARY_DIR=docs/referencias # carpeta fuente de verdad
# REFERENCE_LIBRARY_DB=backend/data/reference_library/library.db
# EMBEDDING_PROVIDER=local               # local (gratis) | azure | openai
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# REFERENCE_FEWSHOT_TOP_K=5              # ejemplos por campo (3, 5, 10...)
# REFERENCE_FEWSHOT_MAX=20               # tope de ejemplos por bloque enviado al LLM
# REFERENCE_FEWSHOT_MIN_SIM=0.55
# REFERENCE_CLASSIFY_MIN_SCORE=0.30
# REFERENCE_CLASSIFY_MIN_SHARE=0.60
